{
  "id": "sikemux.github",
  "name": "GitHub",
  "version": "0.1.0",
  "sikemux": ">=0.4",
  "callTimeoutSecs": 120,
  "environment": ["GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN", "GH_HOST"],
  "writes": ["addComment", "cancel", "createIssue", "createPull", "deleteRun", "deleteRunLogs", "dispatch", "mergePull", "rerun", "rerunJob", "reviewDeployment", "reviewPull", "setIssueState", "setPullState"],
  "accountMethods": ["setDefaultAccount", "signIn", "signOut"],
  "codeHost": {
    "label": "GitHub",
    "ciName": "Actions",
    "runPath": "/actions/runs/",
    "jobPath": "/job/",
    "pullHeads": "pull",
    "merges": ["squash", "merge", "rebase"],
    "webHosts": ["github.com"],
    "compare": {
      "path": "compare/{branch}",
      "query": {
        "expand": "1"
      }
    },
    "pulls": {
      "mergeMethods": ["squash", "merge", "rebase"],
      "requestChanges": true,
      "reopen": true,
      "mergeability": true
    },
    "ci": {
      "attempts": true,
      "approvals": true,
      "dispatch": true,
      "annotations": true,
      "summaries": true,
      "artifacts": true,
      "billing": true,
      "workflowFile": true,
      "rerunFailed": true,
      "rerunJob": true,
      "debugLogs": true,
      "deleteRuns": true,
      "deleteLogs": true
    }
  }
}
