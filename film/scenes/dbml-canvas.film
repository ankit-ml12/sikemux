# The DBML viewer full size: a schema file opened as a diagram, then hovered, a table dragged,
# laid out again, pinched in, panned and pinched back out.
project shop shop
open db/schema.dbml
settle 5
cursor 1300,700
record
wait 0.6
zoom 300,170,880,520 1.1 &
move 700,500 1.2
wait 0.3
move 694,488 0.6
wait 1.4
still hover-orders
move 1058,378 0.9
wait 0.6
drag 1080,215 1.1
wait 0.6
still dragged
click 1155,827
wait 1.2
still arranged
move 694,488 1.0
wait 0.3
pinch 1.9 1.1
wait 0.5
move 734,541 0.7
wait 1.6
still column-tip
move 800,560 0.5
pan -260,-160 1.2
wait 0.8
pan 200,120 1.0
wait 0.4
pinch 0.55 1.0
wait 0.6
still pinched-out
click 1111,827
wait 1.0
still fitted
zoom out 0.9 &
move 1300,700 1.0
end 2.2
