# The DBML viewer full size: a schema file opened as a diagram, then hovered, pinched in, a
# column's tip read, a table dragged, laid out again, panned and fitted.
project shop shop
open db/schema.dbml
settle 5
cursor 1300,700
record
wait 0.3
zoom 310,330,860,300 0.9 &
move 850,452 1.0
wait 0.7
still hover-orders
pinch 1.9 0.8
wait 0.3
zoom 700,380,500,320 0.8 &
move 861,494 0.5
wait 0.9
still column-tip
zoom 300,180,900,680 0.8 &
move 578,582 0.7
drag 600,700 0.8
wait 0.3
still dragged
click 1155,827
wait 0.7
still arranged
move 640,470 0.6
pinch 1.7 0.8
pan -300,-60 1.0
pan 220,40 0.8
wait 0.2
still panned
click 1111,827
wait 0.6
still fitted
zoom out 0.8 &
move 1300,700 0.8
end 1.6
