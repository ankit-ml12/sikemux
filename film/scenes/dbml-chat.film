# The DBML viewer in a chat: Claude answers with a ```dbml block, which draws itself as a
# diagram while it streams in, and is then hovered, pinched and panned.
replies replies.json
project shop shop
chat Wren
settle 6
cursor 1200,700
record
wait 0.2
zoom 760,800 1.9 0.8 &
move 600,768 0.8
click
type "draw the shop's schema so I can see how orders connect" 26
key enter
hold 0.5
zoom 760,520 1.25 0.8 &
wait 6.5
move 318,600 0.6
scroll 220 0.8
zoom 360,230,760,480 0.8 &
move 696,552 0.8
wait 0.8
still card-hover
move 712,598 0.4
wait 0.8
still card-tip
move 760,560 0.4
pinch 1.45 0.8
pan -120,-60 0.8
wait 0.3
still card-pinched
move 1250,700 0.8 &
zoom out 0.8
end 1.6
